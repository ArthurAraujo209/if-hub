# ============================================================ # ARQUIVO DE EXEMPLO - Copie para .env e preencha seus dados
# ============================================================

# SUAP OAuth
# Obtenha essas credenciais no SUAP IFRN
CLIENT_ID=seu_client_id_aqui
CLIENT_SECRET=seu_client_secret_aqui

# REDIRECT_URI muda de acordo com o ambiente:
# - Local: http://localhost:3000/auth/callback
# - Produção: https://seu-backend-domain.com/auth/callback
REDIRECT_URI=http://localhost:3000/auth/callback

SUAP_BASE_URL=https://suap.ifrn.edu.br
SESSION_SECRET=sua_chave_secreta_aqui

# Frontend URL - O backend detecta automaticamente baseado na origem
# Mas você pode forçar aqui (opcional)
# FRONTEND_URL=http://localhost:5500

# Servidor
PORT=3000
NODE_ENV=development

# Firebase - Credenciais do seu projeto
FIREBASE_PROJECT_ID=seu_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=seu_service_account@iam.gserviceaccount.com

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=sua_chave_publica_aqui
VAPID_PRIVATE_KEY=sua_chave_privada_aqui
VAPID_SUBJECT=mailto:seu_email@example.com
